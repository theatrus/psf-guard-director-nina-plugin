<ResourceDictionary x:Class="PsfGuard.Director.Plugin.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="PSF Guard Director_Options">
        <Grid MaxWidth="640" HorizontalAlignment="Left" Margin="0,8"
              Loaded="SettingsLoaded" Unloaded="SettingsUnloaded" IsVisibleChanged="SettingsVisibilityChanged">
            <Grid.Resources>
                <!-- NINA's implicit CheckBox style draws only an ON/OFF switch. -->
                <Style x:Key="LabeledOption" TargetType="CheckBox">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ActionLabel" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                    <Setter Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Profile" Margin="0,4,16,8" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProfileName}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock Grid.Row="1" Text="Planner version" Margin="0,4,16,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EngineVersion}" Margin="0,4,0,8" />
            <TextBlock Grid.Row="2" Text="Runtime" Margin="0,4,16,8" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeStatus}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock Grid.Row="3" Text="Acquisition" Margin="0,4,16,8" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AcquisitionStatus}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <Button Command="{Binding StartRuntimeCommand}" Style="{DynamicResource StandardButton}" MinWidth="112" Margin="0,0,8,8" Padding="12,6">
                    <TextBlock Text="Start runtime" Style="{StaticResource ActionLabel}" />
                </Button>
                <Button Command="{Binding StopRuntimeCommand}" Style="{DynamicResource StandardButton}" MinWidth="112" Margin="0,0,0,8" Padding="12,6">
                    <TextBlock Text="Stop runtime" Style="{StaticResource ActionLabel}" />
                </Button>
            </WrapPanel>
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" DataContext="{Binding Connection}" Margin="0,16,0,0">
                <TextBlock Text="Coordinator" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="Server URL" Margin="0,0,0,4" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" MinWidth="160" />
                <CheckBox Content="Allow unencrypted HTTP" Style="{StaticResource LabeledOption}" IsChecked="{Binding AllowInsecureHttp}" IsEnabled="{Binding IsEditable}" Margin="0,8,0,8" />
                <TextBlock Text="Pairing code" Margin="0,0,0,4" />
                <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" MinWidth="160" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Command="{Binding PairCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6">
                        <TextBlock Text="Pair" Style="{StaticResource ActionLabel}" />
                    </Button>
                    <Button Command="{Binding ResetPairingCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,0,8" Padding="12,6">
                        <TextBlock Text="Reset pairing" Style="{StaticResource ActionLabel}" />
                    </Button>
                </WrapPanel>
                <TextBlock Text="{Binding PairingStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DataContext.EquipmentReportStatus, RelativeSource={RelativeSource AncestorType=Grid}}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <CheckBox Content="Send star-detection settings to PSF Guard" Style="{StaticResource LabeledOption}" IsChecked="{Binding SendStarDetectionSettings}" Margin="0,0,0,4" />
                <TextBlock Text="PSF Guard uses them to count stars and measure HFR as N.I.N.A. does." TextWrapping="Wrap" />
                <CheckBox Content="Report sequence activity to PSF Guard" Style="{StaticResource LabeledOption}" IsChecked="{Binding ReportSequenceActivity}" Margin="0,8,0,4" />
                <TextBlock Text="Show the active Advanced Sequencer instructions when a Director Session is not running." TextWrapping="Wrap" />
                <CheckBox Content="Upload captured frames to PSF Guard" Style="{StaticResource LabeledOption}" IsChecked="{Binding UploadCapturedFrames}" Margin="0,8,0,4" />
                <TextBlock Text="After N.I.N.A. saves a frame that a Director Session captured, Director uploads it to the paired PSF Guard database. Turn on Image uploads for that database in PSF Guard." TextWrapping="Wrap" />
                <TextBlock Text="{Binding UploadStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding UploadQueueStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="Director holds frames PSF Guard refused, such as one it removed on purpose, and frames for an earlier pairing. Retry refused uploads queues refused frames again. Forget held uploads removes both kinds from the queue. The image files stay on disk."
                           TextWrapping="Wrap" Margin="0,4,0,4" />
                <WrapPanel>
                    <Button Command="{Binding RetryRefusedUploadsCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6">
                        <TextBlock Text="Retry refused uploads" Style="{StaticResource ActionLabel}" />
                    </Button>
                    <Button Command="{Binding ForgetHeldUploadsCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,0,8" Padding="12,6">
                        <TextBlock Text="Forget held uploads" Style="{StaticResource ActionLabel}" />
                    </Button>
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,16,0,0">
                <TextBlock Text="Saved runs" FontWeight="Bold" Margin="0,0,0,8" />
                <WrapPanel>
                    <Button Command="{Binding CheckInCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6">
                        <TextBlock Text="Check in" Style="{StaticResource ActionLabel}" />
                    </Button>
                    <Button Command="{Binding CancelCheckInCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,0,8" Padding="12,6">
                        <TextBlock Text="Cancel" Style="{StaticResource ActionLabel}" />
                    </Button>
                </WrapPanel>
                <TextBlock Text="{Binding CheckInStatus}" TextWrapping="Wrap" />
                <Expander IsExpanded="False" HorizontalContentAlignment="Stretch"
                          DataContext="{Binding Collaboration}" Margin="0,16,0,0">
                    <Expander.Header>
                        <TextBlock Text="Standalone collaboration" Foreground="{DynamicResource PrimaryBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Server URL" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" />
                        <TextBlock Text="Remote rig name" Margin="0,8,0,4" />
                        <TextBox Text="{Binding RigName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" MaxLength="128" />
                        <CheckBox Content="Allow loopback HTTP for isolated testing" Style="{StaticResource LabeledOption}" IsChecked="{Binding AllowLoopbackHttp}" IsEnabled="{Binding IsEditable}" Margin="0,8,0,8" />
                        <TextBlock Text="Pairing code" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" MaxLength="512" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding PairCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6"><TextBlock Text="Pair" Style="{StaticResource ActionLabel}" /></Button>
                            <Button Command="{Binding SigninCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6"><TextBlock Text="Browser sign-in" Style="{StaticResource ActionLabel}" /></Button>
                            <Button Command="{Binding OpenSigninCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6"><TextBlock Text="Open sign-in" Style="{StaticResource ActionLabel}" /></Button>
                            <Button Command="{Binding PollCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6"><TextBlock Text="Check approval" Style="{StaticResource ActionLabel}" /></Button>
                            <Button Command="{Binding ValidateCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6"><TextBlock Text="Check connection" Style="{StaticResource ActionLabel}" /></Button>
                            <Button Command="{Binding DisconnectCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6"><TextBlock Text="Disconnect" Style="{StaticResource ActionLabel}" /></Button>
                            <Button Command="{Binding NewConnectionCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6"><TextBlock Text="New connection" Style="{StaticResource ActionLabel}" /></Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>

<ResourceDictionary x:Class="PsfGuard.Director.Plugin.Sequencer.DirectorSessionTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PsfGuard.Director.Plugin.Sequencer"
    xmlns:alt="clr-namespace:NINA.WPF.Base.View;assembly=NINA.WPF.Base"
    xmlns:behaviors="clr-namespace:NINA.Sequencer.Behaviors;assembly=NINA.Sequencer"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:seq="clr-namespace:NINA.Sequencer.SequenceItem;assembly=NINA.Sequencer"
    xmlns:trigger="clr-namespace:NINA.Sequencer.Trigger;assembly=NINA.Sequencer"
    xmlns:condition="clr-namespace:NINA.Sequencer.Conditions;assembly=NINA.Sequencer"
    xmlns:container="clr-namespace:NINA.Sequencer.Container;assembly=NINA.Sequencer">
    <DataTemplate x:Key="DirectorSectionHeader"><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}" /></DataTemplate>
    <Style x:Key="DirectorStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <DataTemplate DataType="{x:Type local:DirectorFlatsItem}">
        <StackPanel Margin="8" DataContext="{Binding Options}">
            <TextBlock Text="Take panel flats for active PSF Guard plans, including completed light-frame goals. Saved batches are reused for this setup until local noon. Replacement requests in PSF Guard are checked before capture."
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Text="The connected cover closes for flats. Tracking and guiding stop. Flats use the current camera angle; Director does not rotate the camera for this instruction." TextWrapping="Wrap" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Flats per filter and camera setting" TextWrapping="Wrap" Margin="0,5,12,5" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FlatsPerFilter, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Flats per filter and camera setting" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Panel brightness (%)" TextWrapping="Wrap" Margin="0,5,12,5" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FlatBrightness, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Panel brightness (%)" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Minimum flat exposure (seconds)" TextWrapping="Wrap" Margin="0,5,12,5" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FlatMinimumSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Minimum flat exposure (seconds)" Margin="0,3" />
                <TextBlock Grid.Row="3" Text="Maximum flat exposure (seconds)" TextWrapping="Wrap" Margin="0,5,12,5" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FlatMaximumSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Maximum flat exposure (seconds)" Margin="0,3" />
                <TextBlock Grid.Row="4" Text="Keep the cover closed when finished" TextWrapping="Wrap" Margin="0,8,12,8" />
                <CheckBox Grid.Row="4" Grid.Column="1" AutomationProperties.Name="Keep the cover closed when finished" IsChecked="{Binding ClosePanelAtEnd}" Margin="0,8" />
            </Grid>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DirectorHookEditor">
        <Expander IsExpanded="{Binding IsExpanded}" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
            <Expander.Header>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding DisableEnableCommand}" Style="{DynamicResource StandardButton}" Width="28" Height="28" ToolTip="Enable or disable instruction slot">
                        <Path Data="{DynamicResource PowerSVG}" Fill="{DynamicResource ButtonForegroundBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Expander.Header>
            <StackPanel Margin="8">
                <GroupBox Header="Instructions" Margin="0,4">
                    <ItemsControl ItemsSource="{Binding Items}" MinHeight="48" Background="{DynamicResource BackgroundBrush}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type seq:SequenceItem}"><nina:SequenceBlockView /></DataTemplate>
                            <DataTemplate DataType="{x:Type container:SequenceContainer}"><nina:SequenceContainerView /></DataTemplate>
                        </ItemsControl.Resources>
                        <i:Interaction.Behaviors>
                            <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                            <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Container.ISequenceContainer;NINA.Sequencer.SequenceItem.ISequenceItem;NINA.Sequencer.TemplatedSequenceContainer" OnDropCommand="DropIntoCommand" />
                        </i:Interaction.Behaviors>
                    </ItemsControl>
                </GroupBox>
                <Expander Header="Triggers and conditions" HeaderTemplate="{StaticResource DirectorSectionHeader}" HorizontalContentAlignment="Stretch">
                    <StackPanel>
                        <GroupBox Header="Triggers" Margin="0,4">
                            <ItemsControl ItemsSource="{Binding Triggers}" MinHeight="40" Background="{DynamicResource BackgroundBrush}">
                                <i:Interaction.Behaviors>
                                    <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                    <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Trigger.ISequenceTrigger" OnDropCommand="DropIntoTriggersCommand" />
                                </i:Interaction.Behaviors>
                                <ItemsControl.Resources><DataTemplate DataType="{x:Type trigger:SequenceTrigger}"><nina:SequenceBlockView /></DataTemplate></ItemsControl.Resources>
                            </ItemsControl>
                        </GroupBox>
                        <GroupBox Header="Conditions" Margin="0,4">
                            <ItemsControl ItemsSource="{Binding Conditions}" MinHeight="40" Background="{DynamicResource BackgroundBrush}">
                                <i:Interaction.Behaviors>
                                    <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                    <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Conditions.ISequenceCondition" OnDropCommand="DropIntoConditionsCommand" />
                                </i:Interaction.Behaviors>
                                <ItemsControl.Resources><DataTemplate DataType="{x:Type condition:SequenceCondition}"><nina:SequenceBlockView /></DataTemplate></ItemsControl.Resources>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Expander>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:DirectorSessionContainer}">
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,8">
            <i:Interaction.Behaviors>
                <behaviors:DragOverBehavior AllowDragCenter="False" DragAboveSize="25" DragBelowSize="15" />
            </i:Interaction.Behaviors>
            <Expander IsExpanded="{Binding IsExpanded}" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{DynamicResource StandardButton}" Command="{Binding DisableEnableCommand}" ToolTip="Enable or disable session" Width="28" Height="28" Margin="4,0">
                                <Path Data="{DynamicResource PowerSVG}" Fill="{DynamicResource ButtonForegroundBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Style="{DynamicResource StandardButton}" Command="{Binding ResetProgressCommand}" ToolTip="Reset display progress" Width="28" Height="28" Margin="4,0">
                                <Path Data="{DynamicResource RefreshSVG}" Fill="{DynamicResource ButtonForegroundBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Style="{DynamicResource StandardButton}" Command="{Binding MoveUpCommand}" ToolTip="Move session up" Width="28" Height="28" Margin="4,0">
                                <Path Data="{DynamicResource ArrowUpSVG}" Fill="{DynamicResource ButtonForegroundBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Style="{DynamicResource StandardButton}" Command="{Binding MoveDownCommand}" ToolTip="Move session down" Width="28" Height="28" Margin="4,0">
                                <Path Data="{DynamicResource ArrowDownSVG}" Fill="{DynamicResource ButtonForegroundBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Style="{DynamicResource StandardButton}" Command="{Binding AddCloneToParentCommand}" ToolTip="Duplicate session" Width="28" Height="28" Margin="4,0">
                                <Path Data="{DynamicResource CopySVG}" Fill="{DynamicResource ButtonForegroundBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Style="{DynamicResource StandardButton}" Command="{Binding DetachCommand}" ToolTip="Remove session" Width="28" Height="28" Margin="4,0">
                                <Path Data="{DynamicResource TrashCanSVG}" Fill="{DynamicResource ButtonForegroundBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center">
                            <i:Interaction.Behaviors><behaviors:DragDropBehavior /></i:Interaction.Behaviors>
                        </TextBlock>
                    </DockPanel>
                </Expander.Header>
                <StackPanel Margin="12">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding SessionStatus}" Style="{StaticResource DirectorStatusText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentDisplay.Operation}" TextWrapping="Wrap" Margin="0,8,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DirectorStatusText}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentDisplay.Operation}" Value="-"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentDisplay.Operation}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentDisplay.Phase}" Value="Running N.I.N.A. trigger"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentDisplay.Target, StringFormat=Target: {0}}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DirectorStatusText}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentDisplay.Target}" Value="-"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentDisplay.Target}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding ConfigurationIssues}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TabControl>
                        <TabItem Header="Overview">
                            <StackPanel Margin="8" MaxWidth="720" HorizontalAlignment="Left">
                                <Grid DataContext="{Binding CurrentDisplay}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="Safety" Margin="0,5,24,5" /><TextBlock Grid.Column="1" Text="{Binding Safety}" TextWrapping="Wrap" Margin="0,5" />
                                    <TextBlock Grid.Row="1" Text="Image quality" Margin="0,5,24,5" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Quality}" TextWrapping="Wrap" Margin="0,5" />
                                    <TextBlock Grid.Row="2" Text="PSF Guard" Margin="0,5,24,5" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Connectivity}" TextWrapping="Wrap" Margin="0,5" />
                                </Grid>
                                <Expander Header="Diagnostics" HeaderTemplate="{StaticResource DirectorSectionHeader}" IsExpanded="False" HorizontalContentAlignment="Stretch" Margin="0,12,0,0">
                                    <StackPanel Margin="8">
                                        <Grid DataContext="{Binding CurrentDisplay}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Rig database" Margin="0,5,24,5" /><TextBlock Grid.Column="1" Text="{Binding Rig}" TextWrapping="Wrap" Margin="0,5" />
                                            <TextBlock Grid.Row="1" Text="Project" Margin="0,5,24,5" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Project}" TextWrapping="Wrap" Margin="0,5" />
                                            <TextBlock Grid.Row="2" Text="Goal" Margin="0,5,24,5" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Goal}" TextWrapping="Wrap" Margin="0,5" />
                                            <TextBlock Grid.Row="3" Text="Program revision" Margin="0,5,24,5" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProgramRevision}" TextWrapping="Wrap" Margin="0,5" />
                                            <TextBlock Grid.Row="4" Text="Pending records" Margin="0,5,24,5" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding QueueDepth}" TextWrapping="Wrap" Margin="0,5" />
                                            <TextBlock Grid.Row="5" Text="Last report" Margin="0,5,24,5" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastCheckIn}" TextWrapping="Wrap" Margin="0,5" />
                                            <TextBlock Grid.Row="6" Text="Wait details" Margin="0,5,24,5" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding WaitReason}" TextWrapping="Wrap" Margin="0,5" />
                                        </Grid>
                                        <TextBlock Text="Equipment is reported automatically when this session starts." TextWrapping="Wrap" Margin="0,12,0,6" />
                                        <Button Command="{Binding ReportEquipmentCommand}" Style="{DynamicResource StandardButton}"
                                            ToolTip="Refresh equipment details in PSF Guard without starting acquisition."
                                            HorizontalAlignment="Left" Margin="0,0,0,6" Padding="12,6">
                                            <TextBlock Text="Report equipment" Foreground="{DynamicResource ButtonForegroundBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Settings">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Readiness}" TextWrapping="Wrap" Margin="8,0,8,12" />
                                <Grid Margin="8,0,8,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Enable acquisition" TextWrapping="Wrap" Margin="0,5,12,5" VerticalAlignment="Center" />
                                    <CheckBox HorizontalAlignment="Left" Grid.Column="1" IsChecked="{Binding Options.EnableAcquisition}" AutomationProperties.Name="Enable acquisition" VerticalAlignment="Center" Margin="0,5" />
                                </Grid>
                                <Expander Header="Reuse settings for this profile" HeaderTemplate="{StaticResource DirectorSectionHeader}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding DefaultsStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <Button Command="{Binding SaveDefaultsCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,8" Padding="12,6"><TextBlock Text="Save as profile defaults" Foreground="{DynamicResource ButtonForegroundBrush}" /></Button>
                                            <Button Command="{Binding LoadDefaultsCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,0,8" Padding="12,6"><TextBlock Text="Load profile defaults" Foreground="{DynamicResource ButtonForegroundBrush}" /></Button>
                                        </WrapPanel>
                                        <TextBlock Text="Loading replaces this session's settings. Instructions, triggers and Enable acquisition are kept. You can also edit defaults on the Director plugin page." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                                <local:DirectorSessionSettings DataContext="{Binding Options}" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Instructions">
                            <ItemsControl ItemsSource="{Binding InstructionBlocks}" ItemTemplate="{StaticResource DirectorHookEditor}" Margin="8" />
                        </TabItem>
                        <TabItem Header="Triggers and conditions">
                            <StackPanel Margin="8">
                                <TextBlock Text="Drag triggers and loop conditions here from N.I.N.A.'s sequencer sidebar. Global triggers on parent containers also run during Director Session." TextWrapping="Wrap" Margin="0,0,0,12" />
                                <GroupBox Header="Triggers" Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding Triggers}" MinHeight="64" Background="{DynamicResource BackgroundBrush}">
                                        <i:Interaction.Behaviors>
                                            <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                            <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Trigger.ISequenceTrigger" OnDropCommand="DropIntoTriggersCommand" />
                                        </i:Interaction.Behaviors>
                                        <ItemsControl.Resources><DataTemplate DataType="{x:Type trigger:SequenceTrigger}"><nina:SequenceBlockView /></DataTemplate></ItemsControl.Resources>
                                    </ItemsControl>
                                </GroupBox>
                                <GroupBox Header="Conditions">
                                    <ItemsControl ItemsSource="{Binding Conditions}" MinHeight="64" Background="{DynamicResource BackgroundBrush}">
                                        <i:Interaction.Behaviors>
                                            <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                            <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Conditions.ISequenceCondition" OnDropCommand="DropIntoConditionsCommand" />
                                        </i:Interaction.Behaviors>
                                        <ItemsControl.Resources><DataTemplate DataType="{x:Type condition:SequenceCondition}"><nina:SequenceBlockView /></DataTemplate></ItemsControl.Resources>
                                    </ItemsControl>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Sky">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding SkyTarget.Name, TargetNullValue=No target selected}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <alt:AltitudeChart Height="220" HorizontalAlignment="Stretch" AnnotateAltitudeAxis="True"
                                    DataContext="{Binding SkyTarget}" NighttimeData="{Binding DataContext.SkyNighttime, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Activity">
                            <DataGrid ItemsSource="{Binding ActionHistory}" Height="320" Margin="8" AutoGenerateColumns="False" IsReadOnly="True"
                                CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" RowHeight="NaN">
                                <DataGrid.Resources><Style x:Key="DirectorActivityText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style></DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="75" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" MinWidth="100" ElementStyle="{StaticResource DirectorActivityText}" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110" ElementStyle="{StaticResource DirectorActivityText}" />
                                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="1.4*" MinWidth="160" ElementStyle="{StaticResource DirectorActivityText}" />
                                    <DataGridTextColumn Header="ms" Binding="{Binding ElapsedMs}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Expander>
        </Border>
    </DataTemplate>
</ResourceDictionary>
